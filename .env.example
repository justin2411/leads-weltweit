# Skripte (lokal oder in geplanten Aufgaben). Nie committen.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Versand: smtp (z. B. Zoho) oder resend
MAIL_TRANSPORT=resend
MAIL_FROM="Signalwerk <hello@<zweitdomain>>"
SENDER_NAME=Signalwerk
SENDER_POSTAL_ADDRESS=
# Abmeldung: reply (Antwort mit "unsubscribe", Standard) oder link (braucht die Vercel-App)
UNSUBSCRIBE_MODE=reply
REPLY_TO=
APP_BASE_URL=https://<vercel-app>.vercel.app

# SMTP/IMAP (Zoho EU: smtp.zoho.eu:465, imap.zoho.eu)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.zoho.eu
IMAP_USER=
IMAP_PASSWORD=

# nur bei MAIL_TRANSPORT=resend
RESEND_API_KEY=

# Quellen (kostenlose Schlüssel)
COMPANIES_HOUSE_API_KEY=
SOCRATA_APP_TOKEN=
