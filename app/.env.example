# In Vercel unter Project Settings -> Environment Variables setzen. Nie committen.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Resend -> Webhooks -> Signing secret (beginnt mit whsec_). Nur nötig, wenn über Resend gesendet wird.
RESEND_WEBHOOK_SECRET=
# Login für das Dashboard (nur Inhaber)
DASHBOARD_PASSWORD=
# Zufälliger langer Wert (z. B. openssl rand -hex 32)
SESSION_SECRET=
