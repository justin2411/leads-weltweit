# In Vercel unter Project Settings -> Environment Variables setzen. Nie committen.
# Pflicht für den ersten Start:
SUPABASE_URL=https://udkkchduyrkzuktlknbc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=            # langer Zufallswert, z. B. openssl rand -hex 32
DASHBOARD_PASSWORD=
SITE_URL=https://leads-weltweit.vercel.app   # später https://nextgen-profit.de
# Optional:
RESEND_API_KEY=            # nur Mails mit Einwilligung (Probe, Willkommen) – keine Kaltakquise
MAIL_FROM=                 # z. B. Justin Koch <info@nextgen-profit.de>
REPLY_TO=
RESEND_WEBHOOK_SECRET=     # whsec_… aus Resend -> Webhooks
STRIPE_SECRET_KEY=         # sk_test_… (Testmodus); ohne Schlüssel ist der Bezahlablauf aus
STRIPE_WEBHOOK_SECRET=     # whsec_… aus Stripe -> Webhooks (Endpunkt /api/webhooks/stripe)
BRAND_NAME=NextGen Profit
